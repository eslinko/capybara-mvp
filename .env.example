# Capybara CLI + host — separate from deploy scripts/.env
# Copy to capybara/.env and fill values (do not commit secrets).
# Override path: CAPYBARA_ENV_PATH=/absolute/path/to/env
# Host (`npm start`) loads CAPYBARA_DOTENV_PATH before main() (EDGE-05); platform env wins (no overwrite).

# --- Host listen + identity auth keyMap (EDGE-01…06 / arch-08) ---
# Placeholders only — never commit real secrets.
PORT=18080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Optional alias for SUPABASE_SECRET_KEY (read when SECRET_KEY empty): SUPABASE_SERVICE_ROLE_KEY=
CAPY_BEARER_SECRET=your_bearer_signing_secret

# Network — any EVM (not Polygon-only). Change RPC, chain id, and explorer together.
# DogeOS Testnet example (chain id 6281971; explorer URL has no secret).
# Replace CAPY_RPC_URL with the operator endpoint for that chain.
CAPY_RPC_URL=https://YOUR_EVM_RPC_HOST
CAPY_CHAIN_ID=6281971
# Human explorer base URL only (http or https). Indexer API is SCANNER_API_* (EVM-03), not this key.
NETWORK_SCANNER=https://dogeos-testnet.l2scan.co/
# SCANNER is a deprecated alias of NETWORK_SCANNER. Read only when NETWORK_SCANNER is empty. Do not set both.
# SCANNER=
# Polygon mainnet alternative (public https://polygon-rpc.com returns 401; needs a provider key):
# CAPY_RPC_URL=https://rpc.ankr.com/polygon/YOUR_ANKR_API_KEY
# CAPY_CHAIN_ID=137
# NETWORK_SCANNER=https://polygonscan.com/
# Ankr / Alchemy shapes and the RPC guide: scripts/docs/analysis/manual-RPC-ankr-podklyuchenie-2026-07-01.md

# $CAPY token (existing ERC20). Required for actions 0–4 and 52.
# CAPYBARA_ACTION=51 (deploy) may omit this until the new contract address is known.
CAPY_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer wallet for CAPYBARA_ACTION=51 (deploy) and 52 (mint). Not used by actions 0–4.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000004
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_or_with_0x

# Family pool address (Phase 2 bootstrap / REQ-08·10). Public address only — NOT a private key.
# Separate setting from PARENT_ADDRESS even when the hex value is identical (REQ-04 AC-A05/A06).
# Terminal MetaMask POC signs this address for pool proof (REQ-10 AC-W06).
CAPY_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# Public HTTPS origin for unique-token sign URLs (REQ-10 / arch-10). No trailing slash.
# Example Railway: https://capybara-mvp.up.railway.app
CAPY_PUBLIC_BASE_URL=https://example.example

# Shared secret for POST /sign/mint (header X-Capy-Sign-Mint-Secret). Operator/POC only — never put in Skill prompt body.
CAPY_SIGN_MINT_SECRET=replace_with_long_random_hex

# Parent (exchange) wallet — also founder parent proof field for bootstrap (distinct from CAPY_POOL_ADDRESS).
PARENT_ADDRESS=0x0000000000000000000000000000000000000001
PARENT_PRIVATE_KEY=your_parent_private_key_without_0x_or_with_0x

# Daily payment rates per child ($CAPY per calendar day)
CAPY_DAILY_TRISTAN=5
CAPY_DAILY_BASTIAN=5

# Child wallets
TRISTAN_ADDRESS=0x0000000000000000000000000000000000000002
TRISTAN_PRIVATE_KEY=your_tristan_private_key_without_0x_or_with_0x

BASTIAN_ADDRESS=0x0000000000000000000000000000000000000003
BASTIAN_PRIVATE_KEY=your_bastian_private_key_without_0x_or_with_0x

# Co-parent (Miguel) — ops address only for invite/Sign after kids (INV-06 / G6 / AC-M04).
# Public address — NOT a private key. Sign via MetaMask; do not invent MIGUEL_PRIVATE_KEY here.
MIGUEL_ADDRESS=0x0000000000000000000000000000000000000005

# Runtime mode: default mock (dry-run, no real transfers); gfl_reality = live боевой режим
# CAPY_MODE=mock

# Indexer API (optional). Fast reconcile for action 2. Chain id follows CAPY_CHAIN_ID.
# CAPY_RECONCILE selects the config source for action 2 actual:
#   auto (default) | journal | indexer | blockscan
# auto, journal, and indexer follow the key: SCANNER_API_KEY (or POLYGONSCAN_API_KEY alias) → indexer; no key → journal.
# blockscan forces a full RPC scan even when a key is set.
# Journal risk: the NDJSON log is trusted. A transfer made outside the CLI is invisible, and a forgotten API key uses the journal instead of the chain.
# CAPY_RECONCILE=auto
# SCANNER_API_KEY=your_etherscan_compatible_api_key
# SCANNER_API_BASE=https://api.etherscan.io/v2/api
# POLYGONSCAN_API_KEY and POLYGONSCAN_API_BASE are deprecated aliases (read only when SCANNER_API_* is empty).
# POLYGONSCAN_API_KEY=
# POLYGONSCAN_API_BASE=
# POLYGONSCAN_CHAIN_ID is ignored. Indexer chainid is CAPY_CHAIN_ID.
# POLYGONSCAN_CHAIN_ID=

# CLI env for action 1 (set at runtime, not loaded from .env):
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_AMOUNT=10.5   # optional; omit to sweep full balance

# CLI env for action 2 (daily payments):
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_FROM=2026-06-01   # optional YYYY-MM-DD
# CAPYBARA_TO=2026-07-01     # optional YYYY-MM-DD; default today

# CLI env for action 3 (charge child → parent pool):
# CAPYBARA_WALLET=tristan|bastian|all
# CAPYBARA_AMOUNT=100        # required; for all = total split across children
# CAPYBARA_SPLIT=tristan:60,bastian:40   # optional; percents must sum to 100

# CLI env for action 6 (debt ledger). Comments only; no secrets and no family amounts.
# CAPYBARA_ACTION=6
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_DEBT_OP=create|forgive|set-due|fine|cancel-fine|summary|show|repay|reconcile|sanction-add|sanction-cancel|resolve-closure
# CAPYBARA_DEBT_AMOUNT is a human decimal (5 or 5.555) with at most the token's decimals.
# The debt journal stores token raw and amount_unit token_raw. Percent, all, and amount are mutually exclusive.
# CAPY_DEBT_MAX_OUTSTANDING in the limits file is human whole CAPY and is scaled to raw when the ledger loads.
# CAPYBARA_DEBT_ID=
# CAPYBARA_DEBT_AMOUNT=5.555
# CAPYBARA_DEBT_PERCENT=
# CAPYBARA_DEBT_ALL=true
# CAPYBARA_DEBT_REASON=
# CAPYBARA_DEBT_DUE=YYYY-MM-DD
# CAPYBARA_DEBT_DUE_CLEAR=true
# CAPYBARA_DEBT_FINE_ID=
# CAPYBARA_DEBT_OVERRIDE_REASON=
# CAPYBARA_DEBT_OPERATION_ID=
# CAPYBARA_DEBT_SANCTION_TYPE=gadget|block-new-debts
# CAPYBARA_DEBT_SANCTION_ID=
# CAPYBARA_DEBT_DATES=YYYY-MM-DD,YYYY-MM-DD
# CAPYBARA_DEBT_DECISIONS=sanction_id:leave,sanction_id:cancel
# CAPYBARA_DEBT_CANCEL_REASON=
# Mutations show a preview and wait for a TTY confirm (да/yes/y). summary and show do not.
# summary and show print one JSON object to stdout (remainder via projectDebtRemainder; fields *_human, journalPath).
# Create writes the debt journal only. It does not change the on-chain balance.
# repay uses CapyToken into the parent pool and settles only in the debt journal.
# reconcile finishes an existing CAPYBARA_DEBT_OPERATION_ID and does not send another transfer.
# sanction rows do not control a device. A duplicate gadget day displays once, with every reason.
# resolve-closure leave/cancel does not change a fixed fine and does not touch another debt.
# A non-TTY close with active sanctions needs CAPYBARA_DEBT_DECISIONS before the transfer.

# CLI env for action 7 (advance ledger). Comments only; no secrets and no family amounts.
# settle is an action 7 operation. Embedded ADVANCE_ID clawback after payout is action 4.
# CAPYBARA_ACTION=7
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_ADVANCE_OP=issue|forgive|settle|summary|show
# CAPYBARA_ADVANCE_AMOUNT is a human decimal. The advance journal stores token raw.
# CAPYBARA_ADVANCE_REASON=
# CAPYBARA_ADVANCE_ID=
# CAPYBARA_ADVANCE_OVERRIDE_REASON=
# CAPYBARA_SYSTEM=
# CAPYBARA_SUBJECT=
# Limits SSOT: config/advance-limits.json (gitignore). Template: config/advance-limits.example.json.
# Optional env overlay (smoke/CI): CAPY_ADVANCE_MAX_OPEN, CAPY_ADVANCE_MAX_OUTSTANDING
# issue, forgive, and settle preview and wait for a TTY confirm in gfl_reality. summary and show do not.
# summary and show print one JSON object to stdout and a human block to stderr.
# Mock issue writes the advance journal and does not send a live transfer.
# Action 4 optional CAPYBARA_ADVANCE_ID: preflight balance_now + payout >= remainder before payout.
