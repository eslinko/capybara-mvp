# Capybara CLI — separate from deploy scripts/.env
# Copy to capybara/.env and fill values (do not commit secrets).
# Override path: CAPYBARA_ENV_PATH=/absolute/path/to/env

# Network
# RPC endpoint для Polygon mainnet. Публичный https://polygon-rpc.com больше НЕ работает
# (отдаёт 401 "API key disabled"). Нужен провайдер с API-ключом.
# Ankr:     https://rpc.ankr.com/polygon/<API_KEY>   (ключ из личного кабинета ankr.com)
# Alchemy:  https://polygon-mainnet.g.alchemy.com/v2/<API_KEY>
# Гайд по подключению: scripts/docs/analysis/manual-RPC-ankr-podklyuchenie-2026-07-01.md
CAPY_RPC_URL=https://rpc.ankr.com/polygon/YOUR_ANKR_API_KEY
CAPY_CHAIN_ID=137

# $CAPY token (existing ERC20). Required for actions 0–4 and 52.
# CAPYBARA_ACTION=51 (deploy) may omit this until the new contract address is known.
CAPY_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer wallet for CAPYBARA_ACTION=51 (deploy) and 52 (mint). Not used by actions 0–4.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000004
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_without_0x_or_with_0x

# Parent (exchange) wallet
PARENT_ADDRESS=0x0000000000000000000000000000000000000001
PARENT_PRIVATE_KEY=your_parent_private_key_without_0x_or_with_0x

# Daily payment rates per child ($CAPY per calendar day)
CAPY_DAILY_TRISTAN=5
CAPY_DAILY_BASTIAN=5

# Child wallets
TRISTAN_ADDRESS=0x0000000000000000000000000000000000000002
TRISTAN_PRIVATE_KEY=your_tristan_private_key_without_0x_or_with_0x

BASTIAN_ADDRESS=0x0000000000000000000000000000000000000003
BASTIAN_PRIVATE_KEY=your_bastian_private_key_without_0x_or_with_0x

# Runtime mode: default mock (dry-run, no real transfers); gfl_reality = live боевой режим
# CAPY_MODE=mock

# Polygonscan / Etherscan API key (optional): fast indexer for action 2 reconcile via Etherscan V2
# (https://api.etherscan.io/v2/api?chainid=137); without key → block-scan fallback (slow)
# POLYGONSCAN_API_KEY=your_etherscan_api_key
# Optional overrides (defaults: V2 base + chainid 137):
# POLYGONSCAN_API_BASE=https://api.etherscan.io/v2/api
# POLYGONSCAN_CHAIN_ID=137

# CLI env for action 1 (set at runtime, not loaded from .env):
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_AMOUNT=10.5   # optional; omit to sweep full balance

# CLI env for action 2 (daily payments):
# CAPYBARA_WALLET=tristan|bastian
# CAPYBARA_FROM=2026-06-01   # optional YYYY-MM-DD
# CAPYBARA_TO=2026-07-01     # optional YYYY-MM-DD; default today

# CLI env for action 3 (charge child → parent pool):
# CAPYBARA_WALLET=tristan|bastian|all
# CAPYBARA_AMOUNT=100        # required; for all = total split across children
# CAPYBARA_SPLIT=tristan:60,bastian:40   # optional; percents must sum to 100
